{
  "name": "Voice AI - Outbound Agentic Caller",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [ 250, 300 ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "https://yjsuqdikfkaaeyeieckh.supabase.co/rest/v1/alert_subscriptions?status=eq.active",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "name": "Get Active Alerts from Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "position": [ 450, 300 ],
      "typeVersion": 3
    },
    {
      "parameters": {
        "url": "=http://localhost:3000/api/engine/check-price?crop={{$json[\"crop\"]}}&location={{$json[\"location\"]}}",
        "options": {}
      },
      "name": "Check Live Price",
      "type": "n8n-nodes-base.httpRequest",
      "position": [ 650, 300 ],
      "typeVersion": 3
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $node[\"Get Active Alerts from Supabase\"].json[\"condition\"] === 'above' && $json[\"current_price\"] > $node[\"Get Active Alerts from Supabase\"].json[\"target_price\"] }}",
              "value2": true
            },
            {
              "value1": "={{ $node[\"Get Active Alerts from Supabase\"].json[\"condition\"] === 'below' && $json[\"current_price\"] < $node[\"Get Active Alerts from Supabase\"].json[\"target_price\"] }}",
              "value2": true
            }
          ]
        },
        "combineOperation": "any"
      },
      "name": "Target Price Hit?",
      "type": "n8n-nodes-base.if",
      "position": [ 850, 300 ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/AC_YOUR_ACCOUNT_SID/Calls.json",
        "authentication": "basicAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "=+91{{$node[\"Get Active Alerts from Supabase\"].json[\"phone_number\"]}}"
            },
            {
              "name": "From",
              "value": "+1234567890"
            },
            {
              "name": "Twiml",
              "value": "=<Response><Say>Hello! The price of {{$json[\"crop\"]}} in {{$json[\"location\"]}} has crossed your target. It is now {{$json[\"current_price\"]}} rupees.</Say></Response>"
            }
          ]
        },
        "options": {}
      },
      "name": "Make Outbound Voice Call",
      "type": "n8n-nodes-base.httpRequest",
      "position": [ 1100, 200 ],
      "typeVersion": 3
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://yjsuqdikfkaaeyeieckh.supabase.co/rest/v1/alert_subscriptions?id=eq.{{$node[\"Get Active Alerts from Supabase\"].json[\"id\"]}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "fulfilled"
            }
          ]
        },
        "options": {}
      },
      "name": "Mark Alert Fulfilled in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "position": [ 1300, 200 ],
      "typeVersion": 3
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Active Alerts from Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Alerts from Supabase": {
      "main": [
        [
          {
            "node": "Check Live Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Live Price": {
      "main": [
        [
          {
            "node": "Target Price Hit?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Target Price Hit?": {
      "main": [
        [
          {
            "node": "Make Outbound Voice Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Make Outbound Voice Call": {
      "main": [
        [
          {
            "node": "Mark Alert Fulfilled in Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
